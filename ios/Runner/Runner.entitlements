<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push: Contacts++ chats and "texts from the web are waiting". -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- messages.comeriver.com links open the app (Universal Links). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:messages.comeriver.com</string>
		<!-- contacts.comeriver.com/messages/* (links from Contacts++ and Events++). -->
		<string>applinks:contacts.comeriver.com</string>
	</array>
	<!-- In-App Purchase (Comeriver Pro) needs no entitlement key; enable the capability in Xcode. -->
</dict>
</plist>
